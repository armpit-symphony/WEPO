[Unit]
Description=WEPO Release-Candidate Full Node (mainnet locked)
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/lib/wepo/node

[Service]
Type=simple
User=wepo-node
Group=wepo-node
WorkingDirectory=/opt/wepo/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/wepo/node.env
ExecStart=/opt/wepo/venv/bin/python /opt/wepo/current/wepo-blockchain/core/wepo_node.py --network-profile mainnet --data-dir /var/lib/wepo/node --p2p-port 22567 --api-host 127.0.0.1 --api-port 8122 --no-mining
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/wepo/node
LimitNOFILE=8192
TasksMax=128
CPUQuota=200%
MemoryHigh=60%
MemoryMax=75%

[Install]
WantedBy=multi-user.target
