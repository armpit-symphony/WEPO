# Inert template: example.invalid and REPLACE values must fail host verification.
WEPO_NETWORK_PROFILE="mainnet"
MONGO_URL="mongodb://REPLACE_WITH_PRIVATE_MONGODB_ENDPOINT:27017"
REDIS_URL="redis://REPLACE_WITH_PRIVATE_REDIS_ENDPOINT:6379/0"
DB_NAME="wepo_mainnet"
WEPO_NODE_API_URL="http://127.0.0.1:8122"
WEPO_ALLOWED_ORIGINS="https://wallet.example.invalid"
WEPO_REQUIRE_REDIS_RATE_LIMIT="1"
WEPO_TRUST_PROXY_HEADERS="1"

# Application-level settlement is disabled unless separately reviewed. This is
# independent of consensus transaction fees.
WEPO_CANONICAL_APPLICATION_FEES_ENABLED="false"
WEPO_APP_FEE_SETTLEMENT_ADDRESS=""

# Frozen v1 exclusions. Mainnet ignores opt-ins, but the deployment contract
# also requires these values to remain zero.
WEPO_FEATURE_PRIVACY="0"
WEPO_FEATURE_RWA="0"
WEPO_FEATURE_BTC="0"
WEPO_FEATURE_MESSAGING="0"
WEPO_ENABLE_STAGING_TOGGLES="0"

# Secrets belong in a root-owned 0640 environment file or external secret
# injection mechanism. Never place credentials in this source template.
