# Inert template. Mainnet startup remains impossible until the reviewed
# consensus parameter freeze finalizes genesis, maturity, relay fee, and PoS.
# DNS records for these names remain a release blocker until independently verified.
WEPO_NETWORK_PROFILE="mainnet"
WEPO_REQUIRE_MAINNET_SEEDS="1"
WEPO_STATIC_PEERS="seed-a.example.invalid:22567,seed-b.example.invalid:22567,seed-c.example.invalid:22567"
WEPO_DNS_SEEDS="seed-a.example.invalid,seed-b.example.invalid,seed-c.example.invalid"
WEPO_DANDELION="1"
WEPO_NODE_API_HOST="127.0.0.1"
WEPO_NODE_ALLOWED_ORIGINS=""

# Optional Tor/SOCKS routing is blank by default. If enabled, qualify it in the
# release-candidate network before changing this value.
WEPO_SOCKS5_PROXY=""

# Mandatory launch Ghost verification uses one direct, release-manifest-bound
# executable. Its independently audited SHA-256 must also be frozen in source.
WEPO_SHIELDED_VERIFIER_COMMAND_JSON="[\"/opt/wepo/current/zk/target/release/ghost_verifier\"]"
# The systemd unit constrains the complete node-plus-child process tree.
WEPO_SHIELDED_VERIFIER_TIMEOUT_SECONDS="5"
WEPO_SHIELDED_VERIFIER_MAX_PROOF_BYTES="1048576"
WEPO_SHIELDED_VERIFIER_MAX_CONCURRENT="2"

# Do not add test difficulty, test genesis, or test activation overrides here.
