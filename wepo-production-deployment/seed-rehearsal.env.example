# Isolated three-host RELEASE-CANDIDATE REHEARSAL only.
# This file must never be used to start mainnet. MAINNET_GENESIS_FINALIZED is
# intentionally false and the service template below requires the test profile.

WEPO_NETWORK_PROFILE="test"
WEPO_REQUIRE_MAINNET_SEEDS="0"

# Each host lists the other two public P2P endpoints, never itself. Replace the
# documentation addresses before installation. DNS remains off until a reviewed
# domain and DNS-seed policy exist.
WEPO_STATIC_PEERS="198.51.100.21:22567,198.51.100.22:22567"
WEPO_DNS_SEEDS="off"

# The node API remains loopback-only. Do not expose this port through a cloud
# firewall or reverse proxy for the seed rehearsal.
WEPO_NODE_API_HOST="127.0.0.1"
WEPO_NODE_API_PORT="8122"
WEPO_P2P_PORT="22567"

# Optional outbound anonymity is deliberately unset for deterministic rehearsal.
WEPO_SOCKS5_PROXY=""
