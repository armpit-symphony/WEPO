#
# Copy to backend/.env for local development or staging.
# Adjust values per environment before starting the backend.
#
MONGO_URL="mongodb://127.0.0.1:27018"
REDIS_URL="redis://127.0.0.1:6379"
DB_NAME="wepo_test_wallet_lab"
WEPO_NODE_API_URL="http://127.0.0.1:18212"
# Mainnet hard-locks launch-gated features off. Use "test" only in staging/labs.
WEPO_NETWORK_PROFILE="mainnet"

WEPO_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100"
# Set to 1 ONLY when running behind a reverse proxy that overwrites X-Real-IP /
# X-Forwarded-For with the true client address (see nginx example). Leaving this
# unset makes rate limiting use the real socket peer so forwarding headers cannot
# be spoofed to bypass the limiter. Do not enable on a directly-exposed backend.
WEPO_REQUIRE_REDIS_RATE_LIMIT="1"
WEPO_TRUST_PROXY_HEADERS="0"
#
# Launch-scope feature flags (MAINNET_V1_LAUNCH_SCOPE.md). Disabled by default
# for v1; set to 1 only in staging or once a feature is launch-ready. Gated
# endpoints return HTTP 503 while disabled.
WEPO_FEATURE_PRIVACY="0"          # Ghost transfers / Quantum Vault — DO NOT ENABLE:
                                  # complete verifier exists, but release audit approval, pinned
                                  # artifact digest, resource/fuzz closure, wallet wiring, and
                                  # activation specification are still required.
WEPO_FEATURE_RWA="0"              # on-chain creation exists, but is optional and remains hidden
                                  # until its release acceptance suite and scope approval are green.
WEPO_FEATURE_RWA_TRADE="0"        # RWA trading — off: rides the mock/simplified swap engine.
WEPO_FEATURE_BTC="0"              # BTC proxy/relay, demo rates, simulated liquidity, and swaps
                                  # remain off; the active wallet BTC path is not production-grade.
WEPO_FEATURE_MESSAGING="0"        # implementation exists, but remains optional until its release
                                  # acceptance and metadata-privacy deployment are approved.
WEPO_ENABLE_STAGING_TOGGLES="0"   # staging-only test hooks (e.g. genesis flip)
WEPO_FEATURE_BROWSER_MINING="0"  # in-memory browser mining lab controls; not consensus mining

#
# Privacy foundation — Layer 1 (network/metadata). These apply to the P2P node
# (wepo-blockchain/core/p2p_network.py); see PRIVACY_DESIGN.md.
# Dandelion++ transaction-origin privacy: ON by default; set to 0 only for
# deterministic multi-node smokes/tests where immediate flood is desired.
WEPO_DANDELION="1"
# Route outbound P2P through a SOCKS5 proxy (Tor = 127.0.0.1:9050) so the node
# never exposes a real IP. Empty = direct connections. Required for .onion peers.
WEPO_SOCKS5_PROXY=""
