{
  "name": "wepo-desktop-wallet",
  "version": "1.0.0",
  "description": "WEPO Decentralized Cryptocurrency Wallet - Desktop Edition",
  "main": "src/main.js",
  "homepage": "./",
  "private": true,
  "author": "WEPO Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start-frontend\" \"wait-on http://localhost:3000 && electron .\"",
    "start-frontend": "npm --prefix ../frontend start",
    "build": "npm run build-frontend",
    "build-frontend": "npm --prefix ../frontend run build",
    "pack": "electron-builder --dir",
    "build-ghost-artifacts": "python ..\\wepo-production-deployment\\build-ghost-artifacts.py --output-dir ..\\release-artifacts\\ghost",
    "dist": "npm run dist-win",
    "signing-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1 -PreflightOnly",
    "verify-packaged-desktop": "node scripts/verify-packaged-desktop.js",
    "verify-builder-security": "node scripts/verify-builder-security.js",
    "verify-windows-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1",
    "dist-win": "npm run build-ghost-artifacts && npm run build-frontend && npm run verify-canonical-client && npm run verify-builder-security && npm run signing-preflight && electron-builder --win --x64 && npm run verify-windows-release",
    "verify-canonical-client": "node scripts/verify-canonical-client.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "pe-library": "0.4.1",
    "resedit": "1.7.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.wepo.desktop-wallet",
    "productName": "WEPO Wallet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/build",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../release-artifacts/ghost/artifacts/ghost_wallet_bridge.exe",
        "to": "ghost/ghost_wallet_bridge.exe"
      },
      {
        "from": "../release-artifacts/ghost/artifacts/wepo_zk.wasm",
        "to": "ghost/wepo_zk.wasm"
      },
      {
        "from": "../release-artifacts/ghost/ghost-artifacts.json",
        "to": "ghost/ghost-artifacts.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WEPO Wallet"
    },
    "publish": null
  }
}
